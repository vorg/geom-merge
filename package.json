    "url": "git+https://github.com/vorg/geom-merge.git"
  },
  "license": "MIT",
  "author": "Marcin Ignac <marcin.ignac@gmail.com> (https://github.com/vorg)",
  "contributors": [
    "Damien Seguin (https://github.com/dmnsgn)"
  ],
  "sideEffects": false,
  "type": "module",
  "exports": {
